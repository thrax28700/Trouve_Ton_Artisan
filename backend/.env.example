PORT=5000
NODE_ENV=development

# ── Base de données MySQL ───────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=trouve_ton_artisan
DB_USER=root
DB_PASSWORD=

# ── Sécurité ────────────────────────────────────────────────────────────────
# Clé API utilisée par le frontend pour accéder aux routes publiques
API_KEY=remplacer-par-une-cle-secrete-forte

# Secret JWT pour l'espace administration
JWT_SECRET=remplacer-par-un-secret-jwt-fort

# ── Email (optionnel) ───────────────────────────────────────────────────────
# Laisser vide pour désactiver l'envoi d'e-mails
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=votre-email@gmail.com
MAIL_PASS=votre-mot-de-passe-application
MAIL_RECIPIENT=votre-email@gmail.com

# ── CORS ────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
