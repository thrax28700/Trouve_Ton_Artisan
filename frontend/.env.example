# En développement local (frontend et backend sur des ports différents) :
VITE_API_URL=http://localhost:5000/api

# En production mono-service (le backend sert aussi le frontend, cf. README) :
# laisser VITE_API_URL vide ou absent — le code utilise alors "/api" (même origine).

VITE_API_KEY=change-this-to-a-strong-secret-key
